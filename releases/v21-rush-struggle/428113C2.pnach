// Effect rotation phases: FUN_00251A48 advances three angles per effect slot by
// a fixed amount per tick and wraps them at +/-pi, so at 60fps every aura, glow
// and swirl rotates at double real speed. The rates are plain data words and each
// is read by exactly one instruction in the binary, so halving them is safe and
// needs no trampoline. Halving a positive float = subtract 0x00800000.
[60FPS - effect rotation]
description=Halve the per-tick rotation rates behind auras and effect swirls.
patch=1,EE,002FE72C,word,3D4CCCCC // 0.10 -> 0.05   phase rate, slot +0x28
patch=1,EE,002FE730,word,3DEB851E // 0.23 -> 0.115  phase rate, slot +0x2C
patch=1,EE,002FE734,word,3E0A3D70 // 0.27 -> 0.135  phase rate, slot +0x30
patch=1,EE,002FE738,word,3EE66666 // 0.90 -> 0.45   phase rate, parent branch

// The ki aura. FUN_00164860 is the aura node's vtable[0] method, and in this
// engine vtable[0] is update AND draw in one call - which is why gating the
// call could never work: skipping it deletes a frame of the effect instead of
// slowing it. The function updates first and ends in a tail call that draws
// (FUN_00164268, or FUN_001ADA58 when flags&2), both reached from 00164A9C.
// So the hook lets the prologue establish $s2/$s6, then on odd frames jumps
// straight to 00164A9C: the aura advances at its authored 30Hz while still
// being drawn every frame. Found by measurement - a guarded 0-ki vs max-ki
// activity diff isolated the aura's memory, and a pointer-ownership scan
// named the node that owns it. See docs/findings.md.
[60FPS - aura update rate]
description=Advance the ki aura every other frame so it plays at its real-time speed, while still drawing it at 60fps.
patch=1,EE,000F0740,word,8ED20038 // lw    $s2, 0x38($s6)     replay displaced
patch=1,EE,000F0744,word,26530064 // addiu $s3, $s2, 0x64     replay the delay slot
patch=1,EE,000F0748,word,3C080033 // lui   $8, 0x33
patch=1,EE,000F074C,word,8D081D64 // lw    $8, 0x1d64($8)     frame counter
patch=1,EE,000F0750,word,31080001 // andi  $8, $8, 1
patch=1,EE,000F0754,word,15000003 // bnez  $8, 000F0764       odd frame
patch=1,EE,000F0758,word,00000000 // nop
patch=1,EE,000F075C,word,08059224 // j     0x00164890         even frame: full update
patch=1,EE,000F0760,word,00000000 // nop
patch=1,EE,000F0764,word,080592A7 // j     0x00164A9C         odd frame: draw only
patch=1,EE,000F0768,word,00000000 // nop
patch=1,EE,00164888,word,0803C1D0 // lw -> j 000F0740 (FUN_00164860 entry)

// The tween system - every ease, pulse, fade and blend in the game.
// FUN_00267AC8(obj, seconds, from, to) builds a linear tween by converting a
// duration in SECONDS into a count of frames:
//     obj+0x08 = seconds * 30.0        frames remaining
//     obj+0x0C = (to - from) / frames  step applied per call
// and FUN_00267B00 advances it exactly one step per tick. The 30.0 is the
// game's frame rate written into the arithmetic, so at 60fps the stepper is
// called twice as often against a duration still counted in 30Hz frames and
// every tween finishes in half its intended real time. One word fixes both
// halves at once: 60.0 doubles the frame count and halves the step.
// Found by sweeping RAM for words that REVERSE DIRECTION twice as often rather
// than words that step twice as far - the airborne idle's tell was a triangle
// wave with a 12 vsync period at 30fps and 6 at 60fps. See docs/findings.md.
[60FPS - tween duration]
description=Count tween durations in 60Hz frames so eases, pulses, fades and blends take their intended real time.
patch=1,EE,00267AC8,word,3C014270 // lui $at, 0x4270   30.0 -> 60.0

// The particle system behind auras, ki wisps and trails. FUN_00168084 is an
// effect node's vtable[0], and as with the ki aura that one call both updates
// and draws - it ends in a tail call to the draw (FUN_001ADA58, or FUN_00167E68
// when flags&4). Its update is FUN_00167258, a loop over 20 entries of stride
// 0x70 with several per-tick channels and no timestep between them:
//     lifetime -= 1.0            00167318 supplies the 1.0
//     alpha ramp -= 0.084
//     position += direction * rate(+0x5D4)
//     +0x60C += +0x5D0,  +0x5C8 += +0x5CC
//     a four-phase counter at +0x5BC, +1 per tick
// Halving them one constant at a time reaches only the ones that are constants.
// Gating the update instead fixes every channel together, and the game already
// has the exact branch for it: at 00168104 a global flag sends it straight to
// 001681D4, which is past all the update work and before the draw tail call.
// The hook simply ORs frame parity into that flag test, so the particles
// advance at their authored 30Hz while still being drawn at 60fps.
// The hook sits on the ld at 001680FC rather than the andi at 00168100, because
// the andi's delay slot is the branch itself and a branch cannot sit in one.
[60FPS - particle update rate]
description=Advance aura and trail particles every other frame so they live and fade at their real-time speed, while still drawing them at 60fps.
patch=1,EE,000F0780,word,DC4319F0 // ld   $v1, 0x19F0($v0)   replay displaced
patch=1,EE,000F0784,word,30630100 // andi $v1, $v1, 0x100    replay the delay slot
patch=1,EE,000F0788,word,3C080033 // lui  $t0, 0x33
patch=1,EE,000F078C,word,8D081D64 // lw   $t0, 0x1d64($t0)   frame counter
patch=1,EE,000F0790,word,31080001 // andi $t0, $t0, 1
patch=1,EE,000F0794,word,00681825 // or   $v1, $v1, $t0      odd frame: take the skip
patch=1,EE,000F0798,word,0805A041 // j    0x00168104
patch=1,EE,000F079C,word,00000000 // nop
patch=1,EE,001680FC,word,0803C1E0 // ld -> j 000F0780 (FUN_00168084 update gate)

// The hovering idle bob - the up and down float of a fighter holding station in
// the air. It is not the body animation: the animation clock is already correct
// in the air, which is why every measurement aimed at it kept reading 1.000
// while the hover still looked fast. The bob is generated separately, in
// FUN_001DFD88's tail:
//     001DFF44  lwc1  $f0, -0x6DF0($gp)   phase increment
//     001DFF48  add.s $f0, $f12, $f0      phase += increment, once per tick
//     001DFF54  swc1  $f0, 0xA8($s0)      the phase, at fighter+0xB8
//     001DFF6C  jal   0x0011F588          sine of the phase
//     001DFF74  add.s $f0, $f0, $f0       doubled for amplitude
//     001DFF78  swc1  $f0, 0x24($s0)      the anchor Y, at fighter+0x34
// The increment is pi/30 - one full cycle per 60 ticks, which is two seconds at
// 30Hz and one second at 60. Halving it to pi/60 restores the period and leaves
// the amplitude alone. World position never moves during the bob; the anchor
// absorbs it, which is why a position trace looks perfectly still.
// The constant has four identical copies in the small-data pool and exactly one
// instruction in the whole code segment reads this one, so the patch is private
// to the bob. Found by scanning the model in the REAL hover idle - earlier scans
// sat in the crouched flight pose, where the character does not bob at all.
[60FPS - hover bob]
description=Halve the hovering idle's bob phase so a fighter holding station in the air rises and falls at its real-time speed.
patch=1,EE,002FD468,word,3D56774E // pi/30 -> pi/60   hover bob phase increment

// The blast hit cadence, found 2026-09-06. Every attack's hitbox carries a tick
// counter at H[0x0A] (H = [obj+0x60]) that FUN_001AFE70 advances once a tick,
// and a hit lands when it reaches the interval D[0x0B], authored IN TICKS in the
// move's data record (D = [[obj+0x64]+0x24]). The same counter paces the whole
// attack: it ends once the hits landed, H[0x0B], exceed the maximum D[0x0A].
// Nothing compensates it, so at 60fps a Kamehameha lands its hits twice as fast
// and spends its hit budget in half the real time - the reported "cut short,
// fewer hits". FUN_0012E7C8 is the only thing that increments the counter and
// 001AFE98 is its only caller, so gating that one call on frame parity fixes the
// cadence and the duration together. The first hit of an attack is never delayed
// - the blez at 001AFF08 short-circuits while no hits have landed - so single
// hit melee is untouched. Verified against the 30fps oracle: same save state,
// same scripted input, hits every 8 vsyncs and the damage spanning 32, against
// 4 and 16 unpatched, with damage and hit count identical either way.
[60FPS - blast hit cadence]
description=Pace multi-hit attacks by real time, so Kamehameha-style blasts land their hits at the right rate and last as long as they should.
patch=1,EE,000F0200,word,3C080033 // lui  $t0, 0x33
patch=1,EE,000F0204,word,8D081D64 // lw   $t0, 0x1d64($t0)   frame counter
patch=1,EE,000F0208,word,31080001 // andi $t0, $t0, 1
patch=1,EE,000F020C,word,15000003 // bnez $t0, 000F021C      odd frame: do not count
patch=1,EE,000F0210,word,00000000 // nop
patch=1,EE,000F0214,word,0C04B9F2 // jal  0x0012E7C8         even frame: count as normal
patch=1,EE,000F0218,word,00000000 // nop
patch=1,EE,000F021C,word,0806BFA8 // j    0x001AFEA0         rejoin past the delay slot
patch=1,EE,000F0220,word,00000000 // nop
patch=1,EE,001AFE98,word,0803C080 // jal 0012E7C8 -> j 000F0200 (hitbox counter tick)

// The blast's visible effects, found 2026-09-06. A ki blast is drawn by effect
// nodes of two classes - the beam core, class descriptor 002C3EF0, and the
// flare that follows it, 002C40F0 - and each one's update carries half a dozen
// coupled per-tick channels: a start delay, an emit countdown, a geometry
// cadence that calls the segment builders FUN_00182DE0 and FUN_0018322C, a
// lifetime, a stagger and a fade. Scaling any one of them in isolation does
// nothing, because they are compared against each other; the whole update has
// to run at 30Hz, which is the same fix the ki aura and the particle system
// already use. Both classes open with a call to FUN_0012D1D0 and a branch that
// skips the entire update while still reaching the draw tail call, so ORing
// frame parity into that branch reuses a skip the game already has.
// Measured on screen brightness, the flash goes from 9 vsyncs to 18 against the
// unpatched game's 21, and recovers its two-humped shape - the charge and the
// fire - which at 60fps had merged into one. Damage, hit count and hit cadence
// are untouched, so this composes with the blast hit cadence group.
[60FPS - blast effect duration]
description=Halve every per-tick step in the blast effect nodes, so a ki blast's beam lasts as long as it should without skipping the geometry it rebuilds each frame.
patch=1,EE,0018672C,word,3C013F00 // 1.0 -> 0.5 per tick
patch=1,EE,001867C8,word,3C013F00 // 1.0 -> 0.5 per tick
