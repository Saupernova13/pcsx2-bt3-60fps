patch=1,EE,0024F3D4,word,0803C4E8 // add.s -> j 000F13A0   the +0x44 clock

// Widescreen for the Galaxy S24 Ultra's 3120x1440 panel - 19.5:9, or 2.166667.
// Adapted 2026-09-08 from the stock [Widescreen 16:9] in PCSX2's own
// resources/patches.zip, which is three words:
//
//   002FE4CC  1.166667 -> 1.555167    a projection scale, 7/6 at 4:3
//   002FE594  298.6667 -> 398.1227    the same constant x256, second path
//   00130BF0  lui $at, 0x3F40 -> 0x3F10   an INSTRUCTION: 0.75 -> 0.5625
//
// The third one gives the rule away. 0.75 is 3/4 and 0.5625 is 9/16, so that
// immediate is 1/aspect, and the two data floats are scaled by
// aspect / (4:3) - the factor by which the horizontal field of view widens.
//
// The model reproduces the stock patch from first principles: for 16:9 it
// yields 3FC71C72 and lui 0x3F10, against the shipped 3FC70FB6 and 0x3F10. The
// only difference is that the official patch rounded 4/3 to 1.333.
//
// For 19.5:9 the widen factor is exactly 1.625:
//   002FE4CC  7/6      x 1.625 = 1.895833
//   002FE594  298.6667 x 1.625 = 485.333333
//   00130BF0  1 / (19.5/9)     = 0.461538
//
// lui only sets the top 16 bits, so the last one lands on 0.4609375 rather than
// 0.4615385 - 0.13% narrow, about a third of a pixel across a 3120-wide panel.
// Fixing that would cost a trampoline for no visible gain.
//
// NEVER RUN THIS TOGETHER WITH THE STOCK [Widescreen 16:9]. Both write the same
// three addresses every frame and the result is whichever wins the race. Turn
// the stock one off in the per-game ini's [Patches] section first.
//
// PCSX2 has no 19.5:9 display aspect, so set Aspect Ratio to Stretch and give it
// a 19.5:9 window or fullscreen target. At any other display aspect this patch
// renders a correctly-wide FOV into the wrong shape.
[Widescreen 19.5:9 - S24 Ultra]
description=Widescreen hack retargeted from 16:9 to the S24 Ultra's 19.5:9 panel. Turn the stock Widescreen 16:9 patch OFF.
patch=1,EE,002FE4CC,word,3FF2AAAB // projection scale  7/6 * 1.625 = 1.895833
patch=1,EE,002FE594,word,43F2AAAB // the same, x256    = 485.333333
patch=1,EE,00130BF0,word,3C013EEC // lui $at, 0x3EEC   = 0.4609375, for 1/(19.5/9)

// Two more aspects, added 2026-09-16 for issue #23. Generated by
// tools/widescreen.py from the same model as the group above:
//
//   python tools/widescreen.py --selftest     check it against PCSX2's own patch
//   python tools/widescreen.py 3440x1440      a panel that is not listed here
//
// Everything said above applies to both. Turn the stock [Widescreen 16:9] OFF,
// and set the display Aspect Ratio to Stretch against a window of the matching
// shape - PCSX2 offers no 21:9 or 16:10 display aspect.
//
// "21:9" is a marketing name rather than a ratio. 2560x1080 and 3840x1620 are
// 64:27, or 2.370370, which is the aspect the standard actually defines and
// what this group carries. 3440x1440 is 43:18, or 2.388889; rendering 64:27
// into it stretches the picture 0.8% horizontally, which is not visible.
//
// Both immediates land exactly, unlike 19.5:9's 0.13%: 1/1.6 is 0.625 and
// 27/64 is 0.421875, and both fit in the top 16 bits of a float with nothing
// left to round away.
[Widescreen 16:10]
description=Widescreen hack retargeted from 16:9 to 16:10, for 1920x1200 and 2560x1600 panels. Turn the stock Widescreen 16:9 patch OFF.
patch=1,EE,002FE4CC,word,3FB33333 // projection scale  7/6 * 1.2 = 1.400000
patch=1,EE,002FE594,word,43B33333 // the same, x256    = 358.400000
patch=1,EE,00130BF0,word,3C013F20 // lui $at, 0x3F20   = 0.6250000, for 1/1.6

[Widescreen 21:9]
description=Widescreen hack retargeted from 16:9 to 21:9 (64:27), for 2560x1080 and 3840x1620 panels. Turn the stock Widescreen 16:9 patch OFF.
patch=1,EE,002FE4CC,word,4004BDA1 // projection scale  7/6 * 1.777778 = 2.074074
patch=1,EE,002FE594,word,4404BDA1 // the same, x256    = 530.962963
patch=1,EE,00130BF0,word,3C013ED8 // lui $at, 0x3ED8   = 0.4218750, for 1/(64/27)

// Projectile travel, found 2026-09-09. THE bug behind "blasts travel way too
// fast", and the first one in this project that changes how the game plays
// rather than how it looks: a blast at 2x speed halves the time you have to
// dodge it.
//
// FUN at 001769xx steps every effect node that moves:
//
//   00176A2C  lwc1 $f12, 0x20($s2)   the node class's step, in units PER TICK
//   00176A34  jal  Vec3Scale         temp = [node+0x30] (velocity) * $f12
//   00176A44  jal  Vec3Add           [node+0x10] (position) += temp
//
// pos += vel * step, once a tick, with no delta-time term anywhere - so at
// 60fps a projectile covers exactly twice the ground per real second. For a
// plain ki blast the step is 27.7778 units a tick, identical in both arms,
// which is the whole bug.
//
// Measured by flight time from a passive-CPU training scene, three ranges, the
// opponent's reaction as the clock. Fitting flight = fixed + gap/speed:
//
//   30fps   28.4 vsyncs fixed + 14.02 units/vsync   (841 units/s)
//   60fps   27.2 vsyncs fixed + 28.05 units/vsync  (1683 units/s)
//
// The fixed part is the wind-up before launch and is already correctly paced;
// the travel term is 2.000x. With this group, flight at gaps 420 / 657 / 842
// goes 42 / 51 / 57 vsyncs back to 57 / 74 / 87, against an unpatched
// 58 / 76 / 88 - every range within two vsyncs.
//
// The site does not execute at all in an idle battle: a breakpoint on it never
// fires until something is actually in flight, so nothing outside a live
// projectile is touched.
[60FPS - projectile travel]
description=Halve the effect-node position step, so ki blasts and beams cross the ground at their real speed.
patch=1,EE,000F13C0,word,C64C0020 // lwc1 $f12, 0x20($s2)   replay displaced
patch=1,EE,000F13C4,word,3C083F00 // lui $t0, 0x3f00        0.5f
patch=1,EE,000F13C8,word,44882000 // mtc1 $t0, $f4
patch=1,EE,000F13CC,word,46046302 // mul.s $f12, $f12, $f4  halve the per-tick step
patch=1,EE,000F13D0,word,0805DA8D // j 0x176a34
patch=1,EE,000F13D4,word,00000000 // nop
patch=1,EE,00176A2C,word,0803C4F0 // lwc1 -> j 000F13C0

[60FPS - blast object travel]
description=Halve the per-tick advance of spawned projectiles - the rocks of Frieza's I Might Die This Time and everything else on the same object class - so they cross the gap in real time rather than twice as fast.
