// Auras, glows and swirls rotate at the right speed.
// Halves the per-tick rotation rates (plain data words, one reader each) read by FUN_00251A48.
[60FPS - effect rotation]
description=Halve the per-tick rotation rates behind auras and effect swirls.
patch=1,EE,002FE72C,word,3D4CCCCC // 0.10 -> 0.05   phase rate, slot +0x28
patch=1,EE,002FE730,word,3DEB851E // 0.23 -> 0.115  phase rate, slot +0x2C
patch=1,EE,002FE734,word,3E0A3D70 // 0.27 -> 0.135  phase rate, slot +0x30
patch=1,EE,002FE738,word,3EE66666 // 0.90 -> 0.45   phase rate, parent branch

// The ki aura plays at its real-time speed.
// Hook in FUN_00164860: odd frames jump to 00164A9C (draw only), even frames run the full update.
[60FPS - aura update rate]
description=Advance the ki aura every other frame so it plays at its real-time speed, while still drawing it at 60fps.
patch=1,EE,000F0740,word,8ED20038 // lw    $s2, 0x38($s6)     replay displaced
patch=1,EE,000F0744,word,26530064 // addiu $s3, $s2, 0x64     replay the delay slot
patch=1,EE,000F0748,word,3C080033 // lui   $8, 0x33
patch=1,EE,000F074C,word,8D081D64 // lw    $8, 0x1d64($8)     frame counter
patch=1,EE,000F0750,word,31080001 // andi  $8, $8, 1
patch=1,EE,000F0754,word,15000003 // bnez  $8, 000F0764       odd frame
patch=1,EE,000F0758,word,00000000 // nop
patch=1,EE,000F075C,word,08059224 // j     0x00164890         even frame: full update
patch=1,EE,000F0760,word,00000000 // nop
patch=1,EE,000F0764,word,080592A7 // j     0x00164A9C         odd frame: draw only
patch=1,EE,000F0768,word,00000000 // nop
patch=1,EE,00164888,word,0803C1D0 // lw -> j 000F0740 (FUN_00164860 entry)

// Eases, pulses, fades and blends take their real time.
// FUN_00267AC8 converts seconds to frames with a hard-coded 30.0; 60.0 fixes both frame count and step.
[60FPS - tween duration]
description=Count tween durations in 60Hz frames so eases, pulses, fades and blends take their intended real time.
patch=1,EE,00267AC8,word,3C014270 // lui $at, 0x4270   30.0 -> 60.0

// Aura and trail particles live and fade at their real-time speed.
// Ors frame parity into the global flag test at 00168104 in FUN_00168084, skipping the update on
// odd frames but still drawing.
// The hook sits on the ld at 001680FC because the andi's delay slot is a branch.
[60FPS - particle update rate]
description=Advance aura and trail particles every other frame so they live and fade at their real-time speed, while still drawing them at 60fps.
patch=1,EE,000F0780,word,DC4319F0 // ld   $v1, 0x19F0($v0)   replay displaced
patch=1,EE,000F0784,word,30630100 // andi $v1, $v1, 0x100    replay the delay slot
patch=1,EE,000F0788,word,3C080033 // lui  $t0, 0x33
patch=1,EE,000F078C,word,8D081D64 // lw   $t0, 0x1d64($t0)   frame counter
patch=1,EE,000F0790,word,31080001 // andi $t0, $t0, 1
patch=1,EE,000F0794,word,00681825 // or   $v1, $v1, $t0      odd frame: take the skip
patch=1,EE,000F0798,word,0805A041 // j    0x00168104
patch=1,EE,000F079C,word,00000000 // nop
patch=1,EE,001680FC,word,0803C1E0 // ld -> j 000F0780 (FUN_00168084 update gate)

// A fighter hovering in the air bobs at its real-time speed.
// Halves the phase increment (pi/30) read only by FUN_001DFD88 at 001DFF44.
[60FPS - hover bob]
description=Halve the hovering idle's bob phase so a fighter holding station in the air rises and falls at its real-time speed.
patch=1,EE,002FD468,word,3D56774E // pi/30 -> pi/60   hover bob phase increment

// Multi-hit blasts (Kamehameha) land their hits at the right rate and last their full time.
// Gates the hitbox counter tick FUN_0012E7C8 (called only at 001AFE98) on even frames.
[60FPS - blast hit cadence]
description=Pace multi-hit attacks by real time, so Kamehameha-style blasts land their hits at the right rate and last as long as they should.
patch=1,EE,000F0200,word,3C080033 // lui  $t0, 0x33
patch=1,EE,000F0204,word,8D081D64 // lw   $t0, 0x1d64($t0)   frame counter
patch=1,EE,000F0208,word,31080001 // andi $t0, $t0, 1
patch=1,EE,000F020C,word,15000003 // bnez $t0, 000F021C      odd frame: do not count
patch=1,EE,000F0210,word,00000000 // nop
patch=1,EE,000F0214,word,0C04B9F2 // jal  0x0012E7C8         even frame: count as normal
patch=1,EE,000F0218,word,00000000 // nop
patch=1,EE,000F021C,word,0806BFA8 // j    0x001AFEA0         rejoin past the delay slot
patch=1,EE,000F0220,word,00000000 // nop
patch=1,EE,001AFE98,word,0803C080 // jal 0012E7C8 -> j 000F0200 (hitbox counter tick)

