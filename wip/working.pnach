patch=1,EE,000F13F4,word,080570A5 // j 0x15c294             past the original add
patch=1,EE,000F13F8,word,00000000 // nop
patch=1,EE,0015C28C,word,0803C4F8 // jal Vec3Add -> j 000F13E0

