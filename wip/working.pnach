// Charges and recoveries last their authored time.
// Each state's frame counter gains 1 on even ticks only; the store in the delay slot still runs every tick.
// Counters that are indexes or levels, not clocks, are left alone. The four restore lines put the
// game's own instruction back so old save states are freed on load.
// Generated by tools/phasetimer.py | tools/mkgate.py. See docs/findings/state-machine.md.
[60FPS - state phase timers]
description=Advance each fighter state's frame counter at 30Hz, so charges and recoveries last their authored time.
patch=1,EE,001E6060,word,8E620000 // restore lw v0,(s3): state 93 phase, an index
patch=1,EE,001F3320,word,8E220000 // restore lw v0,(s1): phase index
patch=1,EE,001F9D48,word,8E820000 // restore lw v0,(s4): phase index
patch=1,EE,001FBBD0,word,8E420000 // restore lw v0,(s2): phase index
patch=1,EE,000F1048,word,8E620000 // reload the counter
patch=1,EE,000F104C,word,3C010033 // lui $at, frame counter
patch=1,EE,000F1050,word,8C211D64 // lw $at, ($at)
patch=1,EE,000F1054,word,30210001 // andi $at, $at, 1
patch=1,EE,000F1058,word,14200002 // bnez $at, odd tick: hold
patch=1,EE,000F105C,word,00000000 // nop
patch=1,EE,000F1060,word,24420001 // even tick: count
patch=1,EE,000F1064,word,0807BAED // j 0x1EEBB4
patch=1,EE,000F1068,word,00000000 // nop
patch=1,EE,001EEBAC,word,0803C412 // gate -> 000F1048
patch=1,EE,000F106C,word,8E820000 // reload the counter
patch=1,EE,000F1070,word,3C010033 // lui $at, frame counter
patch=1,EE,000F1074,word,8C211D64 // lw $at, ($at)
patch=1,EE,000F1078,word,30210001 // andi $at, $at, 1
patch=1,EE,000F107C,word,14200002 // bnez $at, odd tick: hold
patch=1,EE,000F1080,word,00000000 // nop
patch=1,EE,000F1084,word,24420001 // even tick: count
patch=1,EE,000F1088,word,0807C5BB // j 0x1F16EC
patch=1,EE,000F108C,word,00000000 // nop
patch=1,EE,001F16E4,word,0803C41B // gate -> 000F106C
patch=1,EE,000F10B4,word,8E620000 // reload the counter
