patch=1,EE,000F1614,word,8D081D64 // lw $t0, 0x1D64($t0)     frame counter
patch=1,EE,000F1618,word,31080001 // andi $t0, $t0, 1
patch=1,EE,000F161C,word,00481025 // or $v0, $v0, $t0        odd frame: frozen too
patch=1,EE,000F1620,word,8FBF0000 // lw $ra, 0($sp)
patch=1,EE,000F1624,word,03E00008 // jr $ra
patch=1,EE,000F1628,word,27BD0010 // addiu $sp, $sp, 16
patch=1,EE,0017797C,word,0C03C580 // jal 0012CED0 -> jal 000F1600   charged ki blast update
