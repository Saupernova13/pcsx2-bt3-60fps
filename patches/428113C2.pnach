gametitle=DragonBall Z - Budokai Tenkaichi 3 (USA) SLUS-21678

// 60fps patch for Budokai Tenkaichi 3 - battles.
// See docs/findings.md for the full derivation.

[60FPS - battle]
description=Run the battle loop at 60fps. Menus and other modes untouched.
patch=1,EE,0012BCE4,word,24040001 // battle loop stride 2 -> 1
[60FPS - animation rate]
description=Halve every animation rate written to entity+0xC80.
patch=1,EE,001C450C,word,0803C010 // swc1 -> j 000F0040
patch=1,EE,000F0040,word,3C083F00 // lui $t0, 0x3f00
patch=1,EE,000F0044,word,44882000 // mtc1 $t0, $f4
patch=1,EE,000F0048,word,4604A102 // mul.s $f4, $f20, $f4
patch=1,EE,000F004C,word,E4440C80 // swc1 $f4, 0xc80($v0)
patch=1,EE,000F0050,word,08071145 // j 0x1c4514
patch=1,EE,000F0054,word,00000000 // nop
[60FPS - input repeat timing]
description=Double the auto-repeat delay and rate so menus scroll at the right speed.
patch=1,EE,002577F8,word,0803C020 // lui -> j 000F0080
patch=1,EE,000F0080,word,00042040 // sll $a0, $a0, 1
patch=1,EE,000F0084,word,00052840 // sll $a1, $a1, 1
patch=1,EE,000F0088,word,3C020033 // lui $v0, 0x33
patch=1,EE,000F008C,word,08095E00 // j 0x257800
patch=1,EE,000F0090,word,00000000 // nop
[60FPS - input timing]
description=Halve the rate of the 128 per-button frame counters so double taps, holds and combo links keep their real-time windows.
patch=1,EE,000F00C0,word,80A20000 // lb $v0, ($a1)          replay displaced
patch=1,EE,000F00C4,word,3C080033 // lui $t0, 0x33
patch=1,EE,000F00C8,word,8D081D64 // lw $t0, 0x1d64($t0)    frame counter
patch=1,EE,000F00CC,word,31080001 // andi $t0, $t0, 1
patch=1,EE,000F00D0,word,15000003 // bnez $t0, 000F00E0     odd frame: do not count
patch=1,EE,000F00D4,word,00000000 // nop
patch=1,EE,000F00D8,word,08074F08 // j 0x1d3c20             even frame: count as normal
patch=1,EE,000F00DC,word,00000000 // nop
patch=1,EE,000F00E0,word,08074F0E // j 0x1d3c38             return without counting
patch=1,EE,000F00E4,word,00000000 // nop
patch=1,EE,001D3C18,word,0803C030 // lb -> j 000F00C0 (FUN_001D3C10 increment path)

// --- alternative to [60FPS - animation rate]: enable one or the other, never both ---
// The rate setter only catches models something explicitly calls SetAnimRate on.
// FUN_0024D410 is where animation time actually advances (time += rate at
// model+0xB40+0x138), so halving there covers every animated model in the game -
// including effect entities that never set a rate. The two getter hooks keep the
// observable rate at its old halved value for the three call sites that read it.
[60FPS - animation clock]
description=Halve the animation clock itself rather than the rate setter, so effects and auras are covered too.
patch=1,EE,000F0100,word,C4800140 // lwc1 $f0, 0x140($a0)   replay displaced
