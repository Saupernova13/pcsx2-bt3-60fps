patch=1,EE,000F080C,word,0C0487AA // jal   Vec4Add             scratch = 0x950 + 0x970
patch=1,EE,000F0810,word,26060970 // addiu $a2, $s0, 0x970     delay slot
patch=1,EE,000F0814,word,3C04000F // lui   $a0, hi(scratch)
patch=1,EE,000F0818,word,348408F0 // ori   $a0, $a0, lo(scratch)
patch=1,EE,000F081C,word,3C083F00 // lui   $t0, 0x3f00         0.5f
patch=1,EE,000F0820,word,44886000 // mtc1  $t0, $f12
patch=1,EE,000F0824,word,0C0487CE // jal   Vec4Scale           scratch *= 0.5 -> midpoint
patch=1,EE,000F0828,word,0080282D // move  $a1, $a0            delay slot
patch=1,EE,000F082C,word,0220202D // move  $a0, $s1            fighter+0x10
patch=1,EE,000F0830,word,3C05000F // lui   $a1, hi(scratch)
patch=1,EE,000F0834,word,34A508F0 // ori   $a1, $a1, lo(scratch)
patch=1,EE,000F0838,word,0C0487B6 // jal   Vec4Sub             fighter+0x10 = midpoint - fighter+0x30
patch=1,EE,000F083C,word,26260020 // addiu $a2, $s1, 0x20      delay slot
patch=1,EE,000F0840,word,08075C48 // j     001D7120            back
patch=1,EE,000F0844,word,00000000 // nop
patch=1,EE,001D7118,word,0803C200 // jal Vec4Sub -> j 000F0800 (FUN_001D70E8 read-back)

// --- airborne motion ------------------------------------------------------
// Ground movement is root motion through the skeleton, and the animation
// clock patch already halves it. Airborne movement does not go through the
// skeleton at all: measured over a launched opponent, the root bone delta is
// exactly 0.0000 for every tick of the flight while the fighter still moves
// 6.4815 units per tick, identically at 30fps and at 60fps. That is why the
// earlier halve-root-motion experiment changed ground speed and left the air
// untouched.
//
// Two engine routines carry it, both the same shape:
//   FUN_001DE000   speed(+0xA8) = approach(speed, target, step)
//                  pos += dir(+0x90) * speed
//   FUN_001DED78   vy(+0xAC)    = approach(vy, target, step)
//                  pos.y += vy
// where approach() is FUN_001DBFF8, a move-toward-by-at-most-step helper.
//
// Both halves have to be halved. Halving only the applied displacement gives
// the right speed but lets the ramp and the decay run at double rate, so the
// knockback ends in half the time; halving only the approach step leaves the
// fighter moving at 2x. The stored speed itself is left in its authored
// 30Hz units, because other code reads it.
[60FPS - airborne motion]
description=Halve both the displacement and the ramp of the airborne directed-travel channel (FUN_001DE000): flight, dashes and knockback.
patch=1,EE,000F0900,word,3C013F00 // lui $at, 0x3F00
patch=1,EE,000F0904,word,44811000 // mtc1 $at, $f2
patch=1,EE,000F0908,word,46027382 // mul.s $f14, $f14, $f2
patch=1,EE,000F090C,word,0C076FFE // jal 0x001DBFF8
patch=1,EE,000F0910,word,00000000 // nop
patch=1,EE,000F0914,word,26050080 // replay 001DE034
patch=1,EE,000F0918,word,E6000098 // replay 001DE038
patch=1,EE,000F091C,word,3C013F00 // lui $at, 0x3F00
patch=1,EE,000F0920,word,44811000 // mtc1 $at, $f2
patch=1,EE,000F0924,word,46020302 // mul.s $f12, $f00, $f2
patch=1,EE,000F0928,word,0C0487CE // jal 0x00121F38
patch=1,EE,000F092C,word,03A0202D // replay 001DE044
patch=1,EE,000F0930,word,08077812 // j 0x001DE048
patch=1,EE,000F0934,word,00000000 // nop
patch=1,EE,001DE02C,word,0803C240 // jal 001DBFF8 -> j trampoline

[60FPS - airborne vertical]
description=The same for the vertical channel (FUN_001DED78): rising, falling and gravity.
patch=1,EE,000F0940,word,3C013F00 // lui $at, 0x3F00
patch=1,EE,000F0944,word,44811000 // mtc1 $at, $f2
patch=1,EE,000F0948,word,46027382 // mul.s $f14, $f14, $f2
patch=1,EE,000F094C,word,0C076FFE // jal 0x001DBFF8
patch=1,EE,000F0950,word,00000000 // nop
patch=1,EE,000F0954,word,C6010004 // replay 001DEDAC
patch=1,EE,000F0958,word,E600009C // replay 001DEDB0
patch=1,EE,000F095C,word,3C013F00 // lui $at, 0x3F00
patch=1,EE,000F0960,word,44811000 // mtc1 $at, $f2
patch=1,EE,000F0964,word,46020002 // mul.s $f00, $f00, $f2
patch=1,EE,000F0968,word,46000840 // add.s $f1, $f1, $f0
patch=1,EE,000F096C,word,08077B6E // j 0x001DEDB8
patch=1,EE,000F0970,word,00000000 // nop
patch=1,EE,001DEDA4,word,0803C250 // jal 001DBFF8 -> j trampoline


// A hit also leaves a decaying slide on the victim: FUN_001DFD88 adds the
// whole of fighter+0x80 to the position every tick and then shortens that
// vector by a fixed epsilon until it reaches zero. Measured across a rush,
// the vector goes 0.9259 -> 0.3086 -> 0 in exactly the same number of ticks
// at 30fps and at 60fps, so the same push is delivered in half the real time.
// Halving both the applied displacement and the epsilon restores it.
[60FPS - airborne residual]
description=Halve the short slide a fighter takes after a hit, and its decay (FUN_001DFD88).
patch=1,EE,000F0980,word,3C013F00 // lui $at, 0x3F00
patch=1,EE,000F0984,word,44816000 // mtc1 $at, $f12
patch=1,EE,000F0988,word,3C04000F // lui $a0, 0x000F
patch=1,EE,000F098C,word,348409E0 // ori $a0, $a0, 0x09E0
patch=1,EE,000F0990,word,0C0487CE // jal 0x00121F38
patch=1,EE,000F0994,word,0220282D // daddu $a1, $s1, $zero
patch=1,EE,000F0998,word,0200202D // replay 001DFDB0
patch=1,EE,000F099C,word,0200282D // replay 001DFDAC
patch=1,EE,000F09A0,word,3C06000F // lui $a2, 0x000F
patch=1,EE,000F09A4,word,0C0487AA // jal 0x00121EA8
patch=1,EE,000F09A8,word,34C609E0 // ori $a2, $a2, 0x09E0
patch=1,EE,000F09AC,word,08077F71 // j 0x001DFDC4
patch=1,EE,000F09B0,word,00000000 // nop
patch=1,EE,000F09B4,word,3C013F00 // lui $at, 0x3F00
patch=1,EE,000F09B8,word,44811000 // mtc1 $at, $f2
patch=1,EE,000F09BC,word,46020842 // mul.s $f1, $f1, $f2
patch=1,EE,000F09C0,word,0220202D // replay 001DFDD8
patch=1,EE,000F09C4,word,08077F78 // j 0x001DFDE0
patch=1,EE,000F09C8,word,00000000 // nop
patch=1,EE,001DFDBC,word,0803C260 // jal Vec4Add -> j trampoline
patch=1,EE,001DFDD8,word,0803C26D // dmove -> j epsilon trampoline


// Gravity proper. FUN_001DED28 is a separate routine from the vertical channel
// in FUN_001DED78, which is why a breakpoint on the latter never fires during a
// free fall and why the first airborne fix left falling at 2x:
//     vy(+0xAC) += g            g = 0.462963 per tick, at $gp-0x6E4C
//     if (vy > 27.777775) vy = 27.777775                at $gp-0x6E48
//     pos.y += vy
// Each constant has exactly one reader in the binary, so the acceleration is
// halved in data and only the application needs a trampoline. The terminal
// velocity is deliberately left alone: vy stays in its authored 30Hz units, so
// the value it clamps to is still correct.
[60FPS - gravity]
description=Halve the gravity acceleration and the vertical step it drives, so a knocked-down fighter falls at its real-time speed (FUN_001DED28).
patch=1,EE,000F0A00,word,C4400004 // replay 001DED58
patch=1,EE,000F0A04,word,3C013F00 // lui $at, 0x3F00
patch=1,EE,000F0A08,word,44811000 // mtc1 $at, $f2
patch=1,EE,000F0A0C,word,46020842 // mul.s $f1, $f1, $f2
patch=1,EE,000F0A10,word,DFBF0000 // replay 001DED60
patch=1,EE,000F0A14,word,46010000 // replay 001DED64
patch=1,EE,000F0A18,word,E4400004 // replay 001DED68
patch=1,EE,000F0A1C,word,08077B5B // j 0x001DED6C
patch=1,EE,000F0A20,word,00000000 // nop
patch=1,EE,001DED58,word,0803C280 // lwc1 -> j trampoline
patch=1,EE,002FD424,word,3E6D0979 // gravity 0.462963 -> 0.231481 per tick

