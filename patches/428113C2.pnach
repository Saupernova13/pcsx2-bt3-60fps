// Effect rotation phases: FUN_00251A48 advances three angles per effect slot by
// a fixed amount per tick and wraps them at +/-pi, so at 60fps every aura, glow
// and swirl rotates at double real speed. The rates are plain data words and each
// is read by exactly one instruction in the binary, so halving them is safe and
// needs no trampoline. Halving a positive float = subtract 0x00800000.
[60FPS - effect rotation]
description=Halve the per-tick rotation rates behind auras and effect swirls.
patch=1,EE,002FE72C,word,3D4CCCCC // 0.10 -> 0.05   phase rate, slot +0x28
patch=1,EE,002FE730,word,3DEB851E // 0.23 -> 0.115  phase rate, slot +0x2C
patch=1,EE,002FE734,word,3E0A3D70 // 0.27 -> 0.135  phase rate, slot +0x30
patch=1,EE,002FE738,word,3EE66666 // 0.90 -> 0.45   phase rate, parent branch

// The ki aura. FUN_00164860 is the aura node's vtable[0] method, and in this
// engine vtable[0] is update AND draw in one call - which is why gating the
// call could never work: skipping it deletes a frame of the effect instead of
// slowing it. The function updates first and ends in a tail call that draws
// (FUN_00164268, or FUN_001ADA58 when flags&2), both reached from 00164A9C.
// So the hook lets the prologue establish $s2/$s6, then on odd frames jumps
// straight to 00164A9C: the aura advances at its authored 30Hz while still
// being drawn every frame. Found by measurement - a guarded 0-ki vs max-ki
// activity diff isolated the aura's memory, and a pointer-ownership scan
// named the node that owns it. See docs/findings.md.
[60FPS - aura update rate]
description=Advance the ki aura every other frame so it plays at its real-time speed, while still drawing it at 60fps.
patch=1,EE,000F0740,word,8ED20038 // lw    $s2, 0x38($s6)     replay displaced
patch=1,EE,000F0744,word,26530064 // addiu $s3, $s2, 0x64     replay the delay slot
patch=1,EE,000F0748,word,3C080033 // lui   $8, 0x33
patch=1,EE,000F074C,word,8D081D64 // lw    $8, 0x1d64($8)     frame counter
patch=1,EE,000F0750,word,31080001 // andi  $8, $8, 1
patch=1,EE,000F0754,word,15000003 // bnez  $8, 000F0764       odd frame
patch=1,EE,000F0758,word,00000000 // nop
patch=1,EE,000F075C,word,08059224 // j     0x00164890         even frame: full update
patch=1,EE,000F0760,word,00000000 // nop
patch=1,EE,000F0764,word,080592A7 // j     0x00164A9C         odd frame: draw only
patch=1,EE,000F0768,word,00000000 // nop
patch=1,EE,00164888,word,0803C1D0 // lw -> j 000F0740 (FUN_00164860 entry)

// --- EXPERIMENT, not part of the shipped fix: halve ALL root motion ---
// Movement in BT3 is 100% root motion through the skeleton. With exactly one
// writer each way (both confirmed by write breakpoint), the per-frame cycle is
//   model+0x950  = fighter+0x10 + fighter+0x30     FUN_001D7198, 001D71F4
//   fighter+0x10 = model+0x970 - fighter+0x30      FUN_001D70E8, 001D7118
// which reduces to  fighter+0x10 += (model+0x970 - model+0x950).  So the whole
// per-frame displacement is that difference, produced by the skeleton pass.
// Replacing model+0x970 with the midpoint of the two halves it exactly.
// EXPECTED: airborne motion becomes correct, GROUND motion becomes half speed.
// That asymmetry is the point of the test - it proves both that this is the one
// movement channel and that ground is already compensated while air is not.
[60FPS - EXPERIMENT halve root motion]
description=Test only. Halves all root motion; ground should go slow, air should become correct.
patch=1,EE,000F0800,word,3C04000F // lui   $a0, hi(scratch)
patch=1,EE,000F0804,word,348408F0 // ori   $a0, $a0, lo(scratch)
patch=1,EE,000F0808,word,26050950 // addiu $a1, $s0, 0x950     pre-skeleton position
patch=1,EE,000F080C,word,0C0487AA // jal   Vec4Add             scratch = 0x950 + 0x970
patch=1,EE,000F0810,word,26060970 // addiu $a2, $s0, 0x970     delay slot
patch=1,EE,000F0814,word,3C04000F // lui   $a0, hi(scratch)
patch=1,EE,000F0818,word,348408F0 // ori   $a0, $a0, lo(scratch)
patch=1,EE,000F081C,word,3C083F00 // lui   $t0, 0x3f00         0.5f
patch=1,EE,000F0820,word,44886000 // mtc1  $t0, $f12
patch=1,EE,000F0824,word,0C0487CE // jal   Vec4Scale           scratch *= 0.5 -> midpoint
patch=1,EE,000F0828,word,0080282D // move  $a1, $a0            delay slot
patch=1,EE,000F082C,word,0220202D // move  $a0, $s1            fighter+0x10
patch=1,EE,000F0830,word,3C05000F // lui   $a1, hi(scratch)
patch=1,EE,000F0834,word,34A508F0 // ori   $a1, $a1, lo(scratch)
patch=1,EE,000F0838,word,0C0487B6 // jal   Vec4Sub             fighter+0x10 = midpoint - fighter+0x30
patch=1,EE,000F083C,word,26260020 // addiu $a2, $s1, 0x20      delay slot
patch=1,EE,000F0840,word,08075C48 // j     001D7120            back
patch=1,EE,000F0844,word,00000000 // nop
patch=1,EE,001D7118,word,0803C200 // jal Vec4Sub -> j 000F0800 (FUN_001D70E8 read-back)

// --- airborne motion ------------------------------------------------------
// Ground movement is root motion through the skeleton, and the animation
// clock patch already halves it. Airborne movement does not go through the
// skeleton at all: measured over a launched opponent, the root bone delta is
// exactly 0.0000 for every tick of the flight while the fighter still moves
// 6.4815 units per tick, identically at 30fps and at 60fps. That is why the
// earlier halve-root-motion experiment changed ground speed and left the air
// untouched.
//
// Two engine routines carry it, both the same shape:
//   FUN_001DE000   speed(+0xA8) = approach(speed, target, step)
//                  pos += dir(+0x90) * speed
//   FUN_001DED78   vy(+0xAC)    = approach(vy, target, step)
//                  pos.y += vy
// where approach() is FUN_001DBFF8, a move-toward-by-at-most-step helper.
//
// Both halves have to be halved. Halving only the applied displacement gives
// the right speed but lets the ramp and the decay run at double rate, so the
// knockback ends in half the time; halving only the approach step leaves the
// fighter moving at 2x. The stored speed itself is left in its authored
// 30Hz units, because other code reads it.
[60FPS - airborne motion]
description=Halve both the displacement and the ramp of the airborne directed-travel channel (FUN_001DE000): flight, dashes and knockback.
patch=1,EE,000F0900,word,3C013F00 // lui $at, 0x3F00
patch=1,EE,000F0904,word,44811000 // mtc1 $at, $f2
patch=1,EE,000F0908,word,46027382 // mul.s $f14, $f14, $f2
patch=1,EE,000F090C,word,0C076FFE // jal 0x001DBFF8
patch=1,EE,000F0910,word,00000000 // nop
patch=1,EE,000F0914,word,26050080 // replay 001DE034
patch=1,EE,000F0918,word,E6000098 // replay 001DE038
patch=1,EE,000F091C,word,3C013F00 // lui $at, 0x3F00
patch=1,EE,000F0920,word,44811000 // mtc1 $at, $f2
patch=1,EE,000F0924,word,46020302 // mul.s $f12, $f00, $f2
patch=1,EE,000F0928,word,0C0487CE // jal 0x00121F38
patch=1,EE,000F092C,word,03A0202D // replay 001DE044
patch=1,EE,000F0930,word,08077812 // j 0x001DE048
patch=1,EE,000F0934,word,00000000 // nop
patch=1,EE,001DE02C,word,0803C240 // jal 001DBFF8 -> j trampoline

