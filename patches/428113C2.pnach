patch=1,EE,000F0148,word,44882000 // mtc1 $t0, $f4
patch=1,EE,000F014C,word,46040002 // mul.s $f0, $f0, $f4
patch=1,EE,000F0150,word,08074DF1 // j 0x1d37c4
patch=1,EE,000F0154,word,00000000 // nop
patch=1,EE,000F0160,word,3C083F00 // lui $t0, 0x3f00
patch=1,EE,000F0164,word,44882000 // mtc1 $t0, $f4
patch=1,EE,000F0168,word,46040002 // mul.s $f0, $f0, $f4
patch=1,EE,000F016C,word,DFBF0000 // ld $ra, ($sp)          replay displaced
patch=1,EE,000F0170,word,080711C6 // j 0x1c4718
patch=1,EE,000F0174,word,00000000 // nop
patch=1,EE,000F0180,word,3C083F00 // lui $t0, 0x3f00
patch=1,EE,000F0184,word,44882000 // mtc1 $t0, $f4
patch=1,EE,000F0188,word,46040002 // mul.s $f0, $f0, $f4
patch=1,EE,000F018C,word,DFBF0000 // ld $ra, ($sp)          replay displaced
patch=1,EE,000F0190,word,08081F2A // j 0x207ca8
