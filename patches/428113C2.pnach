patch=1,EE,0024D440,word,0803C040 // lwc1 -> j 000F0100 (FUN_0024D410 play-once step)
patch=1,EE,0024D470,word,0803C048 // lwc1 -> j 000F0120 (FUN_0024D410 loop step)
patch=1,EE,001D37C0,word,0803C050 // lwc1 -> j 000F0140 (FUN_001D378C step)
